{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "merge-streak-telegram-game",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "MONETAG_ZONE_ID": "12239871",
    "MONETAG_APP_ID": "3572709",
    "ADSGRAM_BLOCK_ID": "59239",
    "ONCLICKA_SPOT_ID": "6155185",
    "ONCLICKA_ADCODE_ID": "472125",
    "TADS_WIDGET_ID": "13243",
    "ADEXIUM_WID": "4672c32d-e0b9-41f8-976d-c7ccc51ac091",
    "GIGAPUB_APP_ID": "9103",
    "ADSUN_BLOCK_ID": "50194",
    "RICHADS_PUB_ID": "1028723",
    "RICHADS_APP_ID": "9621",
    "RICHADS_SITE_ID": "412421",
    "RICHADS_VAST_URL": "https://16793.rtb.adp3.net/pre-roll-rp?pubid=1028723&siteid=412421"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "merge-streak-db",
      "database_id": "5fd01e5a-f606-4955-b533-470355de0025",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["59 23 * * 5"]
  },
  "observability": { "enabled": true }
}
