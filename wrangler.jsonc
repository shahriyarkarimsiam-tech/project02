{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "merge-streak-telegram-game",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "MONETAG_ZONE_ID": "12239871",
    "MONETAG_APP_ID": "3572709"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "merge-streak-db",
      "database_id": "5fd01e5a-f606-4955-b533-470355de0025",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["59 23 * * 5"]
  },
  "observability": { "enabled": true }
}
